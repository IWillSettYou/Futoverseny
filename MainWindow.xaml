<Window x:Class="Futoverseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Futóverseny" Height="400" Width="600">
    <Grid>
        <Menu VerticalAlignment="Top">
            <MenuItem Header="Fájl">
                <MenuItem Header="Megnyit" Click="MenuItem_Open_Click"/>
            </MenuItem>
            <MenuItem Header="Eredménylista" Click="MenuItem_Eredmenylista_Click"/>
        </Menu>

        <Grid Margin="10,30,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Versenyzők listája -->
            <ListBox x:Name="listBoxVersenyzok" SelectionChanged="ListBoxVersenyzok_SelectionChanged" />

            <!-- Részletes adatok -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Rajtszám:"/>
                <TextBox x:Name="txtRajtszam" IsReadOnly="True"/>

                <TextBlock Text="Név:"/>
                <TextBox x:Name="txtNev" IsReadOnly="True"/>

                <TextBlock Text="Születési dátum:"/>
                <TextBox x:Name="txtSzuletes" IsReadOnly="True"/>

                <TextBlock Text="Ország:"/>
                <TextBox x:Name="txtOrszag" IsReadOnly="True"/>

                <TextBlock Text="Időeredmény:"/>
                <TextBox x:Name="txtIdoeredmeny" IsReadOnly="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
